NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
NEXT_PUBLIC_GATEWAY_KEY=CHANGE_ME_must_match_backend_GATEWAY_KEY
# Optional: billing-enabled Google Maps key for rich place embeds
# (ratings/hours/photos). Leave empty for the free keyless map view.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- NE-SAFE AI (all OPTIONAL — app runs keyless in DEMO MODE) ---
# Free basemap (OpenFreeMap, no key needed). Override only if needed.
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/plain
# Optional keys — leave empty for demo fallback:
# NEXT_PUBLIC_WEATHER_API_KEY=
# NEXT_PUBLIC_MAP_API_KEY=
# NEXT_PUBLIC_SATELLITE_API_KEY=
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_FORCE_DEMO=true
