# NE-SAFE AI — free-first env (all optional, app runs keyless in DEMO MODE)
# Copy to .env.local : cp .env.example .env.local
# NEVER commit real keys. Frontend only reads NEXT_PUBLIC_* (publishable).

# --- Existing DRISHTI-X (preserved) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
NEXT_PUBLIC_GATEWAY_KEY=
# NOTE: free-sources-only — no Google/Mapbox keys. Maps are OSM/CARTO/Esri/OpenTopoMap/OpenFreeMap.
NEXT_PUBLIC_OWM_KEY=

# --- NE-SAFE AI (all OPTIONAL — demo fallback when empty) ---
# Free weather: Open-Meteo needs NO key. Fill only if you switch provider.
VITE_WEATHER_API_KEY=
NEXT_PUBLIC_WEATHER_API_KEY=
# Free maps: OpenFreeMap / OSM needs NO key. Fill only for optional Mapbox-style provider.
VITE_MAP_API_KEY=
NEXT_PUBLIC_MAP_API_KEY=
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/bright
# Free satellite: no key by default (simulated observation + open tiles).
VITE_SATELLITE_API_KEY=
NEXT_PUBLIC_SATELLITE_API_KEY=
# Optional backend override
VITE_BACKEND_URL=
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Force demo even if keys exist: true/false
NEXT_PUBLIC_FORCE_DEMO=true

# --- DRISHTI-X PLATFORM (all OPTIONAL — keyless DEMO MODE by default) ---
# Backend data layer (SQLite file fallback when unset)
DATABASE_URL=
REDIS_URL=
# Model artifacts dir (default backend/ml/artifacts)
ML_MODEL_DIR=
# Weather: Open-Meteo needs NO key. IMD is opt-in (never synthesized).
WEATHER_PROVIDER=auto
IMD_API_KEY=
RAIN_WARN_24H=120
RAIN_CRIT_24H=200
# Early-warning probability bands
WARN_PROB_CRIT=0.75
WARN_PROB_WARN=0.5
WARN_PROB_ALERT=0.25
# Satellite (all optional; adapters report NOT_CONFIGURED when empty)
SATELLITE_PROVIDER=demo
COPERNICUS_USER=
EARTHDATA_TOKEN=
# NASA FIRMS fire (optional; fire layer reports NOT_CONFIGURED when empty)
FIRMS_MAP_KEY=
# Auth (optional; gateway key remains backward compatible)
JWT_SECRET=
# Operator logins 'user:role:secret,...' (server-side only, never frontend).
# Roles: see /api/v1/admin/roles. Example: OPERATOR_KEYS=asha:district_admin:REPLACE_ME
OPERATOR_KEYS=
# Set true in production to stop allowing all origins
CORS_STRICT=
# Notifications (optional; router reports NOT_CONFIGURED when empty)
SMS_PROVIDER_KEY=
SMS_PROVIDER_URL=
PUSH_PROVIDER_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Storage (optional; default local filesystem; MinIO via compose --profile full)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=drishti
# Uploads + ML service
MAX_UPLOAD_MB=15
ML_SERVICE_URL=
# Free AI (optional; local-first, nothing auto-downloaded)
AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
