GATEWAY_KEY=CHANGE_ME_set_a_long_random_value_here
# Operator auth: JWT signing secret (required — without it /api/v1/auth/* returns 503).
JWT_SECRET=
# Operator logins 'user:role:secret,...' (server-side only, never frontend).
# Roles must exist in the app RBAC map. Example: OPERATOR_KEYS=asha:district_admin:REPLACE_ME
OPERATOR_KEYS=
CORS_ORIGINS=http://localhost:3000
TELEMETRY_HZ=2
